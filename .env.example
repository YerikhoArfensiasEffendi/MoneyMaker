# Copy this file to .env and fill in your API keys (never commit .env)

# Google Gemini API key (used by google-genai and langchain-google-genai)
GOOGLE_API_KEY=your_gemini_api_key_here

# Optional default model selections
GEMINI_MASTER_MODEL=gemini-2.5-pro
GEMINI_ANALYST_MODEL=gemini-2.5-flash

# Optional SQLite path for LangGraph multi-agent state persistence
CHECKPOINT_DB_PATH=data/checkpoints.sqlite
